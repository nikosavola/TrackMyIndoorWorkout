<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Allow Bluetooth -->
    <!-- Got removed for Huawei AppGallery https://github.com/TrackMyIndoorWorkout/TrackMyIndoorWorkout/issues/299 -->
    <!-- Unsure if Android 13 needs it https://github.com/TrackMyIndoorWorkout/TrackMyIndoorWorkout/issues/454 -->
    <!-- <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" /> -->

    <!-- https://github.com/TrackMyIndoorWorkout/TrackMyIndoorWorkout/issues/27 -->
    <!-- https://github.com/flutter/flutter/issues/27883 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Fixes canLaunch false problem with Android API 30+ -->
    <!-- https://github.com/TrackMyIndoorWorkout/TrackMyIndoorWorkout/issues/134 -->
    <!-- https://github.com/flutter/flutter/issues/63727 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="com.ailife.betterhealth.GET_DATA_API" />
        </intent>
    </queries>

    <!-- Trying to comply with Android 12+ not needing location permission -->
    <!-- Using the same permissions as
      https://github.com/boskokg/flutter_blue_plus/blob/f70249ec27b9b2e8ff0472cb4ba6bf3df9c8175f/example/android/app/src/main/AndroidManifest.xml
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <!-- legacy for Android 11 or lower -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- legacy for Android 9 or lower -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.BODY_SENSORS" />

    <!-- Folder and File Pickers -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="23" />
    <uses-permission android:name="android.permission.READ_INTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="29" />

    <application
        android:label="track_my_indoor_exercise"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:resizeableActivity="true">
            <!-- android:taskAffinity="" -->
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <!-- Theme to apply as soon as Flutter begins rendering frames -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"
                />

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- To get redirect url when using url_launcher   -->
            <!--
                 KNOWN LIMITATION: this is a custom URL scheme, not a verified
                 Android App Link. Android cannot verify that only this app owns
                 "stravaflutter://" - any other installed app that declares the
                 same scheme+host in its own intent-filter can also receive (or
                 spoof) this redirect, and on devices with more than one matching
                 app the user may even be prompted to choose which app handles it.
                 This is a platform limitation of custom schemes, not something
                 fixable from the manifest alone.
                 Mitigation in place: the OAuth "state" parameter is generated
                 per authorization attempt and validated on redirect (see
                 lib/upload/strava/oauth.dart and lib/upload/oauth_state.dart)
                 so a spoofed/replayed redirect is rejected before any token
                 exchange happens.
                 Tracked follow-up: migrate to a verified Android App Link
                 (autoVerify="true" + a Digital Asset Links file hosted at
                 /.well-known/assetlinks.json on a domain the maintainer
                 controls) and the iOS Universal Links equivalent. Out of scope
                 here since it requires hosting domain-verification files.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="stravaflutter" android:host="redirect" />
                <data android:pathPattern="/.*" />
            </intent-filter>

            <!--
                 KNOWN LIMITATION: same custom-URL-scheme caveat as above for
                 "suuntoflutter://" - interceptable by any app registering the
                 same scheme+host. Mitigated by the "state" parameter check in
                 lib/upload/suunto/oauth.dart. See the Strava intent-filter
                 comment above for the full explanation and the App Links
                 follow-up.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="suuntoflutter" android:host="redirect" />
                <data android:pathPattern="/.*" />
            </intent-filter>

            <!--
                 KNOWN LIMITATION: same custom-URL-scheme caveat as above for
                 "mapmyfitnessflutter://" (Under Armour) - interceptable by any
                 app registering the same scheme+host. Mitigated by the "state"
                 parameter check in lib/upload/under_armour/oauth.dart. See the
                 Strava intent-filter comment above for the full explanation and
                 the App Links follow-up.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mapmyfitnessflutter" android:host="redirect" />
                <data android:pathPattern="/.*" />
            </intent-filter>

            <!--
                 KNOWN LIMITATION: same custom-URL-scheme caveat as above for
                 "trainingpeaksflutter://" - interceptable by any app registering
                 the same scheme+host. Mitigated by the "state" parameter check
                 in lib/upload/training_peaks/oauth.dart. See the Strava
                 intent-filter comment above for the full explanation and the
                 App Links follow-up.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="trainingpeaksflutter" android:host="redirect" />
                <data android:pathPattern="/.*" />
            </intent-filter>

            <!-- Receive files -->
            <!-- support opening files into the app -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="application/csv" />
                <data android:pathPattern=".*\\.csv" />
            </intent-filter>

            <!-- upport sharing files into the app -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/csv" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/csv" />
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin.
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries> -->
</manifest>
